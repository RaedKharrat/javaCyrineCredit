<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.ClientDashboardController"
            style="-fx-background-color: #f5f5f5;">

    <!-- Top Navigation Bar -->
    <top>
        <HBox style="-fx-background-color: white; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
              alignment="CENTER_LEFT" spacing="20">

            <!-- Logo/Title -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <ImageView fitWidth="30" fitHeight="30">
                    <Image url="@../images/travel-icon.png" />
                </ImageView>
                <Text fill="#667eea" font="$x3">
                    <Font size="20" style="BOLD"/>
                    Travel Agency
                </Text>
                <Label text="| Client Dashboard" style="-fx-text-fill: #666; -fx-font-size: 14;"/>
            </HBox>

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- User Info -->
            <HBox alignment="CENTER" spacing="10">
                <Label fx:id="welcomeLabel" style="-fx-font-weight: bold;"/>
                <Button fx:id="logoutButton" text="Déconnexion"
                        style="-fx-background-color: #ff6b6b; -fx-text-fill: white; -fx-font-weight: bold;"
                        onAction="#handleLogout"/>
            </HBox>
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: transparent;">

            <!-- Tab 1: View Agents -->
            <Tab text="🏢 Nos Agents">
                <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                    <VBox spacing="20" style="-fx-padding: 20;">
                        <Label text="Nos Agents Disponibles" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #333;"/>

                        <!-- Search Bar -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="searchAgentField" promptText="Rechercher un agent..."
                                       style="-fx-pref-height: 40; -fx-pref-width: 300;"/>
                            <Button text="🔍 Rechercher" style="-fx-pref-height: 40;" onAction="#handleSearchAgent"/>
                            <Button text="🔄 Actualiser" style="-fx-pref-height: 40;" onAction="#handleRefreshAgents"/>
                        </HBox>

                        <!-- Agents Grid -->
                        <GridPane fx:id="agentsGrid" hgap="20" vgap="20"
                                  style="-fx-padding: 10;">
                            <!-- Agents will be loaded dynamically -->
                        </GridPane>

                        <!-- Loading/Message -->
                        <Label fx:id="agentsMessageLabel" style="-fx-text-fill: #666; -fx-font-size: 14;"/>
                    </VBox>
                </ScrollPane>
            </Tab>

            <!-- Tab 2: My Demandes -->
            <Tab text="📝 Mes Demandes">
                <VBox spacing="15" style="-fx-padding: 20;">
                    <Label text="Mes Demandes" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #333;"/>

                    <!-- Create New Demande Button -->
                    <Button fx:id="createDemandeButton" text="+ Nouvelle Demande"
                            style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 45; -fx-pref-width: 200;"
                            onAction="#handleCreateDemande"/>

                    <!-- Demandes Table -->
                    <TableView fx:id="demandesTable" style="-fx-background-color: white;">
                        <columns>
                            <TableColumn fx:id="colTitle" text="Titre" prefWidth="150"/>
                            <TableColumn fx:id="colDestination" text="Destination" prefWidth="120"/>
                            <TableColumn fx:id="colBudget" text="Budget (DT)" prefWidth="100"/>
                            <TableColumn fx:id="colDates" text="Dates" prefWidth="150"/>
                            <TableColumn fx:id="colStatus" text="Statut" prefWidth="120"/>
                            <TableColumn fx:id="colAgent" text="Agent Assigné" prefWidth="120"/>
                            <TableColumn fx:id="colActions" text="Actions" prefWidth="150"/>
                        </columns>
                    </TableView>

                    <!-- No Demandes Message -->
                    <Label fx:id="noDemandesLabel" text="Vous n'avez aucune demande."
                           style="-fx-text-fill: #666; -fx-font-size: 14;" visible="false"/>
                </VBox>
            </Tab>

            <!-- Tab 3: My Reservations -->
            <Tab text="🎫 Mes Réservations">
                <VBox spacing="15" style="-fx-padding: 20;">
                    <Label text="Mes Réservations" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #333;"/>

                    <!-- Reservations Table -->
                    <TableView fx:id="reservationsTable" style="-fx-background-color: white;">
                        <columns>
                            <TableColumn fx:id="colResCode" text="Code" prefWidth="100"/>
                            <TableColumn fx:id="colResDemande" text="Demande" prefWidth="150"/>
                            <TableColumn fx:id="colResDestination" text="Destination" prefWidth="120"/>
                            <TableColumn fx:id="colResPrice" text="Prix Total" prefWidth="100"/>
                            <TableColumn fx:id="colResStatus" text="Statut" prefWidth="120"/>
                            <TableColumn fx:id="colResDate" text="Date de création" prefWidth="150"/>
                            <TableColumn fx:id="colResActions" text="Actions" prefWidth="150"/>
                        </columns>
                    </TableView>

                    <!-- No Reservations Message -->
                    <Label fx:id="noReservationsLabel" text="Vous n'avez aucune réservation."
                           style="-fx-text-fill: #666; -fx-font-size: 14;" visible="false"/>
                </VBox>
            </Tab>

        </TabPane>
    </center>

    <!-- Status Bar -->
    <bottom>
        <HBox style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;"
              alignment="CENTER_RIGHT">
            <Label fx:id="statusLabel" text="Prêt" style="-fx-text-fill: #666;"/>
        </HBox>
    </bottom>

</BorderPane>