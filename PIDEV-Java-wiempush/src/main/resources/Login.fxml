<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.LoginController"
            style="-fx-background-color: linear-gradient(to bottom right, #667eea, #764ba2);">

    <center>
        <VBox alignment="CENTER" spacing="20" prefWidth="400" prefHeight="500">
            <padding>
                <Insets top="50" right="40" bottom="50" left="40"/>
            </padding>

            <!-- Header -->
            <VBox alignment="CENTER" spacing="10">
                <Text fill="white">
                    <font>
                        <Font name="System" size="32" style="BOLD"/>
                    </font>
                    Travel Agency
                </Text>
                <Text fill="#e0e0e0">
                    <font>
                        <Font size="14"/>
                    </font>
                    Connexion à votre compte
                </Text>
            </VBox>

            <!-- Login Form -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30;">
                <Label text="Nom d'utilisateur" style="-fx-font-weight: bold;"/>
                <TextField fx:id="usernameField" promptText="Entrez votre username" style="-fx-pref-height: 40;"/>

                <Label text="Mot de passe" style="-fx-font-weight: bold; -fx-margin-top: 10;"/>
                <PasswordField fx:id="passwordField" promptText="Entrez votre mot de passe" style="-fx-pref-height: 40;"/>

                <!-- Error Message -->
                <Label fx:id="errorLabel" textFill="RED" style="-fx-font-size: 12;" visible="false"/>

                <!-- Login Button -->
                <Button fx:id="loginButton" text="Se connecter"
                        style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 45; -fx-pref-width: 100%;"
                        onAction="#handleLogin"/>

                <!-- Register Link -->
                <HBox alignment="CENTER" spacing="5">
                    <Label text="Pas de compte?"/>
                    <Button fx:id="registerButton" text="S'inscrire"
                            style="-fx-background-color: transparent; -fx-text-fill: #667eea; -fx-font-weight: bold; -fx-underline: true;"
                            onAction="#handleRegister"/>
                </HBox>
            </VBox>

            <!-- Footer -->
            <Label text="© 2024 Travel Agency - Tous droits réservés"
                   style="-fx-text-fill: white; -fx-font-size: 12;"/>
        </VBox>
    </center>
</BorderPane>